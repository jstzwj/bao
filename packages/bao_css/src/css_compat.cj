// ============================================================================
// 兼容性分组名称映射
// 严格翻译自: compat.zig 中共享兼容性检查的特性组
// ============================================================================

/// 获取兼容性分组的人类可读名称
public func getCompatFeatureGroupName(group: CompatFeatureGroup): String {
    match (group) {
        case always_compatible => "Always compatible"
        case never_compatible => "Never compatible"
        case selectors_group => "CSS Selectors"
        case pseudo_element_group => "CSS Pseudo-elements"
        case pseudo_class_group => "CSS Pseudo-classes"
        case at_rule_group => "CSS At-rules"
        case function_group => "CSS Functions"
        case unit_group => "CSS Units"
        case color_group => "CSS Colors"
        case gradient_group => "CSS Gradients"
        case list_style_group => "CSS list-style-type"
        case logical_property_group => "CSS Logical Properties"
        case font_group => "CSS Fonts"
        case size_group => "CSS Sizing"
        case border_group => "CSS Borders"
        case media_query_group => "CSS Media Queries"
        case text_decoration_group => "CSS Text Decoration"
        case custom_selectors_group => "CSS Custom Selectors"
        case selector_level2 => "CSS Selectors Level 2"
        case selector_level3 => "CSS Selectors Level 3"
    }
}

// ============================================================================
// 浏览器兼容性快速检查辅助函数
// 严格翻译自: compat.zig isCompatible 中重复出现的浏览器检查模式
// ============================================================================

/// 检查指定浏览器是否存在且版本低于阈值
/// 严格翻译自: compat.zig 中 if (browsers.xxx) |version| { if (version < N) { return false } } 模式
public func isBrowserBelowVersion(browser: ?UInt32, threshold: UInt32): Bool {
    if (let Some(version) <- browser) {
        return version < threshold
    }
    return false
}

/// 检查指定浏览器是否存在 (非 null)
/// 严格翻译自: compat.zig 中 browsers.xxx != null 检查
public func isBrowserPresent(browser: ?UInt32): Bool {
    return browser.isSome()
}

/// 检查是否所有给定浏览器都不存在 (用于 "仅特定浏览器支持" 的检查)
/// 严格翻译自: compat.zig 中 if (browsers.a != null or browsers.b != null ...) { return false } 模式
public func areAllBrowsersAbsent(browsers: CssBrowsers, browserNames: Array<String>): Bool {
    for (name in browserNames) {
        match (name) {
            case "android" => if (browsers.android.isSome()) { return false }
            case "chrome" => if (browsers.chrome.isSome()) { return false }
            case "edge" => if (browsers.edge.isSome()) { return false }
            case "firefox" => if (browsers.firefox.isSome()) { return false }
            case "ie" => if (browsers.ie.isSome()) { return false }
            case "ios_saf" => if (browsers.ios_saf.isSome()) { return false }
            case "opera" => if (browsers.opera.isSome()) { return false }
            case "safari" => if (browsers.safari.isSome()) { return false }
            case "samsung" => if (browsers.samsung.isSome()) { return false }
            case "" => ()
            case _ => ()
        }
    }
    return true
}

/// 获取浏览器名称列表
/// 返回所有已知的浏览器标识符
public func getAllBrowserNames(): Array<String> {
    return ["android", "chrome", "edge", "firefox", "ie", "ios_saf", "opera", "safari", "samsung"]
}

// ============================================================================
// 独立兼容性检查函数
// 严格翻译自: compat.zig Feature.isCompatible 中每个 switch 分支
// ============================================================================

/// 兼容性检查: abs_function
/// 严格翻译自: compat.zig .abs_function 分组
func isCompatible_abs_function(browsers: CssBrowsers): Bool {
    if (let Some(version) <- browsers.firefox) { if (version < UInt32(7733248)) { return false } }
    if (let Some(version) <- browsers.safari) { if (version < UInt32(984064)) { return false } }
    if (let Some(version) <- browsers.ios_saf) { if (version < UInt32(984064)) { return false } }
    if (browsers.android.isSome() || browsers.chrome.isSome() || browsers.edge.isSome() || browsers.ie.isSome() || browsers.opera.isSome() || browsers.samsung.isSome()) { return false }
    return true
}

/// 兼容性检查: accent_system_color
func isCompatible_accent_system_color(browsers: CssBrowsers): Bool {
    if (let Some(version) <- browsers.firefox) { if (version < UInt32(6750208)) { return false } }
    if (let Some(version) <- browsers.safari) { if (version < UInt32(1049856)) { return false } }
    if (let Some(version) <- browsers.ios_saf) { if (version < UInt32(1049856)) { return false } }
    return true
}

/// 兼容性检查: afar_list_style_type
/// 严格翻译自: compat.zig .afar_list_style_type 分组
func isCompatible_afar_list_style_type(browsers: CssBrowsers): Bool {
    if (let Some(version) <- browsers.chrome) { if (version < UInt32(1179648)) { return false } }
    if (let Some(version) <- browsers.edge) { if (version < UInt32(5963776)) { return false } }
    if (let Some(version) <- browsers.opera) { if (version < UInt32(917504)) { return false } }
    if (let Some(version) <- browsers.safari) { if (version < UInt32(327680)) { return false } }
    if (let Some(version) <- browsers.ios_saf) { if (version < UInt32(262656)) { return false } }
    if (let Some(version) <- browsers.samsung) { if (version < UInt32(65536)) { return false } }
    if (let Some(version) <- browsers.android) { if (version < UInt32(196608)) { return false } }
    if (browsers.firefox.isSome() || browsers.ie.isSome()) { return false }
    return true
}

