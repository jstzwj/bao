// ============================================================================
// 浏览器兼容性查询辅助
// 严格翻译自: compat.zig 中反复出现的浏览器检查模式
// ============================================================================

/// 获取指定浏览器的当前版本
/// 严格翻译自: compat.zig 中 browsers.xxx 访问模式
public func getBrowserVersion(browsers: CssBrowsers, browserName: String): ?UInt32 {
    match (browserName) {
        case "android" => browsers.android
        case "chrome" => browsers.chrome
        case "edge" => browsers.edge
        case "firefox" => browsers.firefox
        case "ie" => browsers.ie
        case "ios_saf" => browsers.ios_saf
        case "opera" => browsers.opera
        case "safari" => browsers.safari
        case "samsung" => browsers.samsung
        case "" => None
        case _ => None
    }
}

/// 检查是否是 Chromium 内核浏览器 (Chrome, Edge >= 79, Opera >= 15, Samsung)
/// 严格翻译自: compat.zig 中多次检查 Chromium 版本的逻辑
public func isChromiumBased(browserName: String): Bool {
    match (browserName) {
        case "chrome" => true
        case "edge" => true
        case "opera" => true
        case "samsung" => true
        case "android" => true
        case _ => false
    }
}

/// 获取特性的兼容性分组名称字符串
/// 严格翻译自: compat.zig 中共享同一分支的特性组标识
public func getFeatureGroupDescription(feature: CompatFeature): String {
    return getCompatFeatureGroupName(getCompatFeatureGroup(feature))
}

/// 批量检查多个特性的兼容性
/// 严格翻译自: compat.zig isCompatible 的批量调用模式
/// 返回第一个不兼容的特性，如果全部兼容则返回 None
public func findFirstIncompatibleFeature(features: Array<CompatFeature>, browsers: CssBrowsers): ?CompatFeature {
    for (feature in features) {
        if (!feature.isCompatible(browsers)) {
            return Some(feature)
        }
    }
    return None
}

/// 批量检查多个特性是否全部兼容
/// 严格翻译自: compat.zig isCompatible 的 AND 组合逻辑
public func areAllFeaturesCompatible(features: Array<CompatFeature>, browsers: CssBrowsers): Bool {
    for (feature in features) {
        if (!feature.isCompatible(browsers)) {
            return false
        }
    }
    return true
}

/// 批量检查是否存在任一特性兼容
/// 严格翻译自: compat.zig isPartiallyCompatible 的 OR 组合逻辑
public func isAnyFeatureCompatible(features: Array<CompatFeature>, browsers: CssBrowsers): Bool {
    for (feature in features) {
        if (feature.isCompatible(browsers)) {
            return true
        }
    }
    return false
}

/// 获取所有不兼容的特性列表
/// 严格翻译自: compat.zig isCompatible 的过滤逻辑
public func getIncompatibleFeatures(features: Array<CompatFeature>, browsers: CssBrowsers): Array<CompatFeature> {
    var result = ArrayList<CompatFeature>()
    for (feature in features) {
        if (!feature.isCompatible(browsers)) {
            result.append(feature)
        }
    }
    return result.toOwnedSlice()
}

/// 获取所有兼容的特性列表
/// 严格翻译自: compat.zig isCompatible 的过滤逻辑
public func getCompatibleFeatures(features: Array<CompatFeature>, browsers: CssBrowsers): Array<CompatFeature> {
    var result = ArrayList<CompatFeature>()
    for (feature in features) {
        if (feature.isCompatible(browsers)) {
            result.append(feature)
        }
    }
    return result.toOwnedSlice()
}

/// 获取浏览器支持报告
/// 严格翻译自: compat.zig isCompatible 的诊断输出
/// 返回每个浏览器对该特性的最低支持版本描述
public func getCompatibilityReport(feature: CompatFeature, browsers: CssBrowsers): String {
    if (feature.isCompatible(browsers)) {
        return "${getFeatureDescription(feature)}: SUPPORTED"
    }
    if (feature.isPartiallyCompatible(browsers)) {
        return "${getFeatureDescription(feature)}: PARTIALLY SUPPORTED"
    }
    return "${getFeatureDescription(feature)}: NOT SUPPORTED"
}

