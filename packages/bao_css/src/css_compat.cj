// ============================================================================
// 版本编码辅助函数
// 严格翻译自: compat.zig 中隐含的版本编码逻辑
// ============================================================================

/// 将主版本号和次版本号编码为 24 位整数
/// 编码方式: (major << 16) | (minor << 8)
/// 严格翻译自: targets.zig 中 Browsers 的版本编码方式
public func encodeBrowserVersion(major: UInt32, minor: UInt32): UInt32 {
    return (major << 16) | (minor << 8)
}

/// 从编码的版本号中解码主版本号
public func decodeBrowserVersionMajor(version: UInt32): UInt32 {
    return version >> 16
}

/// 从编码的版本号中解码次版本号
public func decodeBrowserVersionMinor(version: UInt32): UInt32 {
    return (version >> 8) & 0xFF
}

/// 检查编码版本是否 >= 指定主版本和次版本号
public func versionGte(version: UInt32, major: UInt32, minor: UInt32): Bool {
    return version >= encodeBrowserVersion(major, minor)
}

/// 检查编码版本是否 < 指定主版本和次版本号
public func versionLt(version: UInt32, major: UInt32, minor: UInt32): Bool {
    return version < encodeBrowserVersion(major, minor)
}

/// 将编码版本号转换为可读字符串 (例如 "87.0")
public func browserVersionToString(version: UInt32): String {
    return "${decodeBrowserVersionMajor(version)}.${decodeBrowserVersionMinor(version)}"
}

// ============================================================================
// 特性分组信息
// 严格翻译自: compat.zig isCompatible 中共享同一分支的特性组
// ============================================================================

/// 特性兼容性分组
/// 严格翻译自: compat.zig isCompatible switch 中共享同一分支的特性
/// 在 Zig 源码中，这些特性共享相同的浏览器版本检查逻辑
public enum CompatFeatureGroup {
    | always_compatible                       // 始终兼容 (无浏览器限制)
    | never_compatible                        // 始终不兼容 (custom_media_queries 等)
    | selectors_group                         // CSS 选择器相关
    | pseudo_element_group                    // 伪元素相关
    | pseudo_class_group                      // 伪类相关
    | at_rule_group                           // @规则相关
    | function_group                          // CSS 函数相关
    | unit_group                              // CSS 单位相关
    | color_group                             // 颜色相关
    | gradient_group                          // 渐变相关
    | list_style_group                        // list-style-type 相关
    | logical_property_group                  // 逻辑属性相关
    | font_group                              // 字体相关
    | size_group                              // 尺寸相关
    | border_group                            // 边框相关
    | media_query_group                       // 媒体查询相关
    | text_decoration_group                   // 文本装饰相关
    | custom_selectors_group                  // 自定义选择器相关
    | selector_level2                         // CSS Selectors Level 2
    | selector_level3                         // CSS Selectors Level 3
}

/// 获取特性所属的兼容性分组
/// 严格翻译自: compat.zig isCompatible 中的 switch 分支分组
public func getCompatFeatureGroup(feature: CompatFeature): CompatFeatureGroup {
    match (feature) {
        // 始终不兼容 - 严格翻译自 .custom_media_queries, .fit_content_function_size, .stretch_size 分支
        case custom_media_queries |
             fit_content_function_size |
             stretch_size =>
            CompatFeatureGroup.never_compatible
        // CSS 选择器 Level 2 - 严格翻译自 .selectors2 分支
        case selectors2 =>
            CompatFeatureGroup.selector_level2
        // CSS 选择器 Level 3 - 严格翻译自 .selectors3 分支
        case selectors3 =>
            CompatFeatureGroup.selector_level3
        // 伪元素 - 严格翻译自 .gencontent, .first_line 分支
        case gencontent |
             first_line =>
            CompatFeatureGroup.pseudo_element_group
        // 伪元素 :first-letter - 有独立分支
        case first_letter =>
            CompatFeatureGroup.pseudo_element_group
        // 伪类 - in/out of range
        case in_out_of_range =>
            CompatFeatureGroup.pseudo_class_group
        // 表单验证
        case form_validation =>
            CompatFeatureGroup.pseudo_class_group
        // :any-link - 严格翻译自 .any_link 分支
        case any_link =>
            CompatFeatureGroup.pseudo_class_group
        // :default - 严格翻译自 .default_pseudo 分支
        case default_pseudo =>
            CompatFeatureGroup.pseudo_class_group
        // :dir() - 严格翻译自 .dir_selector 分支
        case dir_selector =>
            CompatFeatureGroup.pseudo_class_group
        // :focus-within - 严格翻译自 .focus_within 分支
        case focus_within =>
            CompatFeatureGroup.pseudo_class_group
        // :focus-visible - 严格翻译自 .focus_visible 分支
        case focus_visible =>
            CompatFeatureGroup.pseudo_class_group
        // :indeterminate - 严格翻译自 .indeterminate_pseudo 分支
        case indeterminate_pseudo =>
            CompatFeatureGroup.pseudo_class_group
        // :is() - 严格翻译自 .is_selector 分支
        case is_selector =>
            CompatFeatureGroup.pseudo_class_group
        // :optional - 严格翻译自 .optional_pseudo 分支
        case optional_pseudo =>
            CompatFeatureGroup.pseudo_class_group
        // :placeholder-shown - 严格翻译自 .placeholder_shown 分支
        case placeholder_shown =>
            CompatFeatureGroup.pseudo_class_group
        // ::dialog - 严格翻译自 .dialog 分支
        case dialog =>
            CompatFeatureGroup.pseudo_element_group
        // :fullscreen - 严格翻译自 .fullscreen 分支
        case fullscreen =>
            CompatFeatureGroup.pseudo_class_group
        // ::marker - 严格翻译自 .marker_pseudo 分支
        case marker_pseudo =>
            CompatFeatureGroup.pseudo_element_group
        // ::placeholder - 严格翻译自 .placeholder 分支
        case placeholder =>
            CompatFeatureGroup.pseudo_element_group
        // ::selection - 严格翻译自 .selection 分支
        case selection =>
            CompatFeatureGroup.pseudo_element_group
        // 大小写不敏感属性选择器
        case case_insensitive =>
            CompatFeatureGroup.selector_level3
        // :read-only/:read-write
        case read_only_write =>
            CompatFeatureGroup.pseudo_class_group
        // :autofill - 严格翻译自 .autofill 分支
        case autofill =>
            CompatFeatureGroup.pseudo_class_group
        // @namespace - 严格翻译自 .namespaces 分支
        case namespaces =>
            CompatFeatureGroup.at_rule_group
        // Shadow DOM v1 - 严格翻译自 .shadowdomv1 分支
        case shadowdomv1 =>
            CompatFeatureGroup.custom_selectors_group
        // 十六进制透明度颜色
        case hex_alpha_colors =>
            CompatFeatureGroup.color_group
        // CSS 嵌套 - 严格翻译自 .nesting 分支
        case nesting =>
            CompatFeatureGroup.custom_selectors_group
        // :not() 选择器列表 - 严格翻译自 .not_selector_list 分支
        case not_selector_list =>
            CompatFeatureGroup.pseudo_class_group
        // :has() - 严格翻译自 .has_selector 分支
        case has_selector =>
            CompatFeatureGroup.pseudo_class_group
        // 字体相关
        case font_family_system_ui |
             font_size_rem |
             font_size_x_x_x_large |
             font_style_oblique_angle |
             font_weight_number |
             font_stretch_percentage |
             extended_system_fonts =>
            CompatFeatureGroup.font_group
        // CSS 函数相关
        case calc_function |
             clamp_function |
             min_function |
             max_function |
             round_function |
             rem_function |
             mod_function |
             abs_function |
             sign_function |
             hypot_function |
             color_function |
             light_dark |
             cue_function |
             image_set =>
            CompatFeatureGroup.function_group
        // CSS 单位相关
        case q_unit |
             cap_unit |
             ch_unit |
             em_unit |
             ex_unit |
             ic_unit |
             lh_unit |
             rcap_unit |
             rch_unit |
             rex_unit |
             ric_unit |
             rem_unit |
             rlh_unit |
             vb_unit |
             vi_unit |
             vh_unit |
             vw_unit |
             vmax_unit |
             vmin_unit |
             x_resolution_unit |
             container_query_length_units |
             viewport_percentage_units_dynamic |
             viewport_percentage_units_large |
             viewport_percentage_units_small =>
            CompatFeatureGroup.unit_group
        // 颜色相关
        case lab_colors |
             oklab_colors |
             p3_colors |
             space_separated_color_notation |
             accent_system_color |
             lang_selector_list =>
            CompatFeatureGroup.color_group
        // 渐变相关
        case conic_gradient |
             repeating_conic_gradient |
             linear_gradient |
             repeating_linear_gradient |
             radial_gradient |
             repeating_radial_gradient |
             gradient_interpolation_hints |
             double_position_gradients =>
            CompatFeatureGroup.gradient_group
        // 逻辑属性相关
        case logical_borders |
             logical_border_shorthand |
             logical_border_radius |
             logical_margin |
             logical_margin_shorthand |
             logical_padding |
             logical_padding_shorthand |
             logical_inset |
             logical_size |
             logical_text_align |
             logical_properties =>
            CompatFeatureGroup.logical_property_group
        // 尺寸相关
        case auto_size |
             fit_content_size |
             is_animatable_size |
             max_content_size |
             min_content_size |
             moz_available_size |
             webkit_fill_available_size |
             anchor_size_size =>
            CompatFeatureGroup.size_group
        // 边框相关
        case border_image_repeat_round |
             border_image_repeat_space =>
            CompatFeatureGroup.border_group
        // 媒体查询相关
        case media_range_syntax |
             media_interval_syntax =>
            CompatFeatureGroup.media_query_group
        // 布局相关
        case place_content |
             place_items |
             place_self |
             overflow_shorthand =>
            CompatFeatureGroup.logical_property_group
        // 文本装饰相关
        case text_decoration_thickness_percent |
             text_decoration_thickness_shorthand =>
            CompatFeatureGroup.text_decoration_group
        // @规则 / 嵌套
        case cue |
             any_pseudo |
             part_pseudo |
             animation_timeline_shorthand =>
            CompatFeatureGroup.at_rule_group
        // :nth-child(of) - 严格翻译自 .nth_child_of 分支
        case nth_child_of =>
            CompatFeatureGroup.pseudo_class_group
        // list-style-type 相关 - 所有 list_style_type 枚举值
        case afar_list_style_type |
             amharic_list_style_type |
             amharic_abegede_list_style_type |
             ethiopic_list_style_type |
             ethiopic_abegede_list_style_type |
             ethiopic_abegede_am_et_list_style_type |
             ethiopic_abegede_gez_list_style_type |
             ethiopic_abegede_ti_er_list_style_type |
