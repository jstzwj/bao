    /// 检查特性是否被任一目标浏览器部分支持
    /// 严格翻译自 Feature.isPartiallyCompatible()
    public func isPartiallyCompatible(targets: CssBrowsers): Bool {
        var browsers = CssBrowsers()
        if (targets.android.isSome()) {
            browsers.android = targets.android
            if (isCompatible(browsers)) { return true }
            browsers.android = None
        }
        if (targets.chrome.isSome()) {
            browsers.chrome = targets.chrome
            if (isCompatible(browsers)) { return true }
            browsers.chrome = None
        }
        if (targets.edge.isSome()) {
            browsers.edge = targets.edge
            if (isCompatible(browsers)) { return true }
            browsers.edge = None
        }
        if (targets.firefox.isSome()) {
            browsers.firefox = targets.firefox
            if (isCompatible(browsers)) { return true }
            browsers.firefox = None
        }
        if (targets.ie.isSome()) {
            browsers.ie = targets.ie
            if (isCompatible(browsers)) { return true }
            browsers.ie = None
        }
        if (targets.ios_saf.isSome()) {
            browsers.ios_saf = targets.ios_saf
            if (isCompatible(browsers)) { return true }
            browsers.ios_saf = None
        }
        if (targets.opera.isSome()) {
            browsers.opera = targets.opera
            if (isCompatible(browsers)) { return true }
            browsers.opera = None
        }
        if (targets.safari.isSome()) {
            browsers.safari = targets.safari
            if (isCompatible(browsers)) { return true }
            browsers.safari = None
        }
        if (targets.samsung.isSome()) {
            browsers.samsung = targets.samsung
            if (isCompatible(browsers)) { return true }
            browsers.samsung = None
        }
        return false
    }
}

// ============================================================================
// 特性描述函数
// 严格翻译自: compat.zig Feature enum 值对应的 CSS 特性名称
// ============================================================================

/// 获取 CSS 特性的人类可读描述名称
/// 严格翻译自: compat.zig Feature enum 中的特性标识符
/// 返回特性的 CSS 标准名称或 MDN 文档标题
public func getFeatureDescription(feature: CompatFeature): String {
    match (feature) {
        // CSS 数学函数
        case abs_function => "CSS abs() function"
        case sign_function => "CSS sign() function"
        case hypot_function => "CSS hypot() function"
        case calc_function => "CSS calc() function"
        case clamp_function => "CSS clamp() function"
        case min_function => "CSS min() function"
        case max_function => "CSS max() function"
        case round_function => "CSS round() function"
        case rem_function => "CSS rem() function"
        case mod_function => "CSS mod() function"
        // CSS 颜色
        case accent_system_color => "accent-color CSS system color"
        case lab_colors => "CSS Lab colors"
        case oklab_colors => "CSS OKLab colors"
        case p3_colors => "CSS display-p3 colors"
        case color_function => "CSS color() function"
        case hex_alpha_colors => "CSS hex alpha colors (#RRGGBBAA)"
        case space_separated_color_notation => "CSS space-separated color notation (rgb 0 0 0 / 0.5)"
        case light_dark => "CSS light-dark() color function"
        // CSS 渐变
        case conic_gradient => "CSS conic-gradient()"
        case repeating_conic_gradient => "CSS repeating-conic-gradient()"
        case linear_gradient => "CSS linear-gradient()"
        case repeating_linear_gradient => "CSS repeating-linear-gradient()"
        case radial_gradient => "CSS radial-gradient()"
        case repeating_radial_gradient => "CSS repeating-radial-gradient()"
        case gradient_interpolation_hints => "CSS gradient interpolation hints"
        case double_position_gradients => "CSS double position gradients"
        // CSS 单位
        case q_unit => "CSS q unit (quarter-millimeters)"
        case cap_unit => "CSS cap unit"
        case ch_unit => "CSS ch unit (character width)"
        case em_unit => "CSS em unit"
        case ex_unit => "CSS ex unit (x-height)"
        case ic_unit => "CSS ic unit (ideograph character)"
        case lh_unit => "CSS lh unit (line-height)"
        case rcap_unit => "CSS rcap unit (root cap)"
        case rch_unit => "CSS rch unit (root ch)"
        case rex_unit => "CSS rex unit (root ex)"
        case ric_unit => "CSS ric unit (root ic)"
        case rem_unit => "CSS rem unit (root em)"
        case rlh_unit => "CSS rlh unit (root line-height)"
        case vb_unit => "CSS vb unit (viewport block)"
        case vi_unit => "CSS vi unit (viewport inline)"
        case vh_unit => "CSS vh unit (viewport height)"
        case vw_unit => "CSS vw unit (viewport width)"
        case vmax_unit => "CSS vmax unit (viewport max)"
        case vmin_unit => "CSS vmin unit (viewport min)"
        case x_resolution_unit => "CSS x resolution unit (dppx)"
        case container_query_length_units => "CSS container query length units (cqw, cqh, etc.)"
        case viewport_percentage_units_dynamic => "CSS viewport percentage units dynamic (dvh, dvw, etc.)"
        case viewport_percentage_units_large => "CSS viewport percentage units large (lvh, lvw, etc.)"
        case viewport_percentage_units_small => "CSS viewport percentage units small (svh, svw, etc.)"
        // CSS 选择器
        case selectors2 => "CSS Selectors Level 2"
        case selectors3 => "CSS Selectors Level 3"
        case any_link => ":any-link pseudo-class"
